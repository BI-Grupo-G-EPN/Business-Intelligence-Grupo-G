{
  "name": "La Tradicional Boulangerie",
  "dataColors": [
    "#1F4FBF",
    "#F2A516",
    "#0E2A6E",
    "#F8D27A",
    "#6E8FD8",
    "#C77D0A",
    "#9AA6BF",
    "#3B6FE0"
  ],
  "background": "#FFFFFF",
  "foreground": "#0E2A6E",
  "tableAccent": "#F2A516",
  "good": "#1F4FBF",
  "neutral": "#F2A516",
  "bad": "#C0392B",
  "maximum": "#1F4FBF",
  "center": "#F8D27A",
  "minimum": "#C0392B",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0E2A6E" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0E2A6E" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0E2A6E" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5A6478" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DCE3F0" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#0E2A6E" } },
          "background": { "solid": { "color": "#F2A516" } },
          "fontSize": 12,
          "bold": true
        }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF2F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EEF2F8" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F4FBF" } }, "fontSize": 28 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5A6478" } }, "fontSize": 11 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F4FBF" } }, "bold": true }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#0E2A6E" } }, "backColorSecondary": { "solid": { "color": "#F4F7FC" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#0E2A6E" } }, "backColor": { "solid": { "color": "#FDF1D6" } }, "bold": true }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#1F4FBF" } }, "bold": true }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#0E2A6E" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#0E2A6E" } }, "backColor": { "solid": { "color": "#FDF1D6" } }, "bold": true }]
      }
    },
    "slicer": {
      "*": {
        "title": [{ "show": false }],
        "header": [{ "fontColor": { "solid": { "color": "#0E2A6E" } } }],
        "items": [{ "fontColor": { "solid": { "color": "#0E2A6E" } } }]
      }
    },
    "shape": {
      "*": {
        "title": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "textbox": {
      "*": {
        "title": [{ "show": false }],
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "image": {
      "*": {
        "title": [{ "show": false }],
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
