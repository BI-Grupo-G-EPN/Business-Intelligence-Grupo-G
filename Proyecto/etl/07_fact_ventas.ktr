    <modified_user>-</modified_user>
    <modified_date>2026/11/13 12:00:00.000</modified_date>
  </info>
  <notepads/>
  <order>
    <hop>
      <from>Leer ventas</from>
      <to>Buscar producto_key</to>
      <enabled>Y</enabled>
