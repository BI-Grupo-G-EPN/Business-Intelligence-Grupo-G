<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>07_fact_ventas</name>
    <description>Carga de la tabla de hechos de ventas - La Tradicional Boulangerie</description>
    <extended_description/>
    <trans_version/>
