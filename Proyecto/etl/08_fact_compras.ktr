  <step>
    <name>Leer compras</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw_la_tradicional</connection>
    <sql>SELECT TRIM(ruc_emisor) AS ruc_emisor,
       fecha_emision,
       tipo_comprobante,
       clave_acceso,
       valor_sin_impuestos,
       iva,
       importe_total
FROM raw_compras</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input/>
      <output/>
    </remotesteps>
    <GUI>
      <xloc>80</xloc>
      <yloc>320</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
